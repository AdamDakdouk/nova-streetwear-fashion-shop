PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_platform
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=NOVA <onboarding@resend.dev>

# Cloudflare R2 (admin product image uploads) - create a bucket + API token at
# dash.cloudflare.com, enable public access on the bucket for R2_PUBLIC_URL
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket-public-url.r2.dev
